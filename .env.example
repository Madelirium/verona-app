# Public browser configuration. Never place secret/service_role keys here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Keep false until Google OAuth and the Supabase provider are configured, then use true.
SUPABASE_AUTH_ENABLED=false
SUPABASE_AUTH_METHOD=google

# Server only. Enable after Google login works. Requires Node >=22.13.
RANKED_ENABLED=false
# SQLite fallback for local development. Do not use this file on Render Free.
RANKED_DB_PATH=.local/ranked.sqlite

# Render: store rooms, queues, matches and Elo in Supabase. Apply the SQL migration first.
# Local development defaults to memory + SQLite. Remote mode never falls back to local storage.
GAME_STORAGE=memory
# Backend only: set this in Render Environment; never use it as a publishable key.
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Public Umami Cloud configuration. Disabled until an account and privacy setup are ready.
ANALYTICS_ENABLED=false
ANALYTICS_PROVIDER=umami
ANALYTICS_UMAMI_WEBSITE_ID=
ANALYTICS_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# Alternative to Umami; remains opt-in. Only a public publishable key belongs here.
# ANALYTICS_PROVIDER=supabase
# ANALYTICS_SUPABASE_ENDPOINT=https://YOUR_PROJECT.supabase.co/functions/v1/usage-count
# ANALYTICS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional walking integration. Provider key belongs only on the Node backend.
# Activate only after confirming provider terms, attribution, quotas and cache permissions.
WALKING_API_URL=
WALKING_API_KEY=
WALKING_ALLOWED_ORIGINS=https://veronaintasca.it
